<Project>

  <!--
    Centralised MSBuild properties for the CreatioHelper solution.
    Auto-imported by every .csproj located under this directory.
    Per-project overrides still win.
  -->

  <PropertyGroup>
    <!-- All projects target .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>

    <!-- Modern C# defaults. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Treat warnings as errors in Release builds. The codebase is warning-clean
         today; this is a guardrail so future regressions fail CI instead of
         silently accumulating. Debug builds keep the warnings visible without
         breaking local dev / hot reload. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <!-- Stable lang version across the solution (default tracks the SDK). -->
    <LangVersion>default</LangVersion>

    <!-- Enforce deterministic builds for reproducible CI artifacts. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>