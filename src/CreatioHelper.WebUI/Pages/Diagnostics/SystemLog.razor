@page "/diagnostics/logs"
@inject IApiClient ApiClient
@inject ISignalRService SignalR
@inject ISnackbar Snackbar
@inject IStringLocalizer<Localization> L
@inject IErrorMessageHelper ErrorHelper
@inject NavigationManager Navigation
@inject IFileDownloadService DownloadService
@implements IDisposable

<PageTitle>@L["SystemLog_Title"] - CreatioHelper Agent</PageTitle>

<div class="logs-fill">
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4" Class="flex-grow-1">@L["SystemLog_Title"]</MudText>
    <div class="d-flex gap-2 gradient-controls">
        <MudSwitch @bind-Value="_liveTail"
                   Color="Color.Primary"
                   Label="@L["SystemLog_TailMode"]" />
    </div>
</div>

<MudPaper Elevation="2" Class="pa-4 mb-2">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect @bind-Value="_selectedLogLevel"
                       @bind-Value:after="ReloadGrid"
                       Label="@L["SystemLog_Level"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">@L["SystemLog_AllLevels"]</MudSelectItem>
                <MudSelectItem Value="@("error")">@L["SystemLog_LevelError"]</MudSelectItem>
                <MudSelectItem Value="@("warning")">@L["SystemLog_LevelWarning"]</MudSelectItem>
                <MudSelectItem Value="@("info")">@L["SystemLog_LevelInfo"]</MudSelectItem>
                <MudSelectItem Value="@("debug")">@L["SystemLog_LevelDebug"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect @bind-Value="_selectedFacility"
                       @bind-Value:after="ReloadGrid"
                       Label="@L["SystemLog_Facility"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">@L["SystemLog_AllFacilities"]</MudSelectItem>
                <MudSelectItem Value="@("sync")">@L["SystemLog_FacilitySync"]</MudSelectItem>
                <MudSelectItem Value="@("model")">@L["SystemLog_FacilityModel"]</MudSelectItem>
                <MudSelectItem Value="@("scanner")">@L["SystemLog_FacilityScanner"]</MudSelectItem>
                <MudSelectItem Value="@("connections")">@L["SystemLog_FacilityConnections"]</MudSelectItem>
                <MudSelectItem Value="@("discover")">@L["SystemLog_FacilityDiscovery"]</MudSelectItem>
                <MudSelectItem Value="@("upnp")">@L["SystemLog_FacilityUpnp"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_searchText"
                          @bind-Value:after="ReloadGrid"
                          Label="@L["SystemLog_Search"]"
                          Placeholder="@L["SystemLog_SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>
</MudPaper>

<div class="d-flex flex-column" style="flex:1 1 auto; min-height:0;">
    <MudDataGrid T="LogEntry"
                 @ref="_grid"
                 VirtualizeServerData="LoadServerData"
                 Dense="true"
                 Hover="true"
                 FixedHeader="true"
                 Virtualize="true"
                 SortMode="SortMode.Single"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterMenu"
                 ShowMenuIcon="true"
                 Height="100%"
                 Elevation="2"
                 Class="log-grid">
        <ToolBarContent>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Download"
                           Size="Size.Small"
                           OnClick="DownloadLogs"
                           aria-label="@L["SystemLog_Download"]" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           OnClick="ReloadGrid"
                           aria-label="@L["SystemLog_Refresh"]" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Timestamp" Title="@_timeLabel"
                            Sortable="true" Hideable="true" Filterable="true"
                            InitialDirection="SortDirection.Descending"
                            SortBy="@_noClientSort" HeaderStyle="width: 130px;" CellClass="log-cell-time">
                <CellTemplate>
                    @LocalTimeConverter.ToLocal(context.Item.Timestamp).ToString("HH:mm:ss.fff")
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Level" Title="@_levelLabel"
                            Sortable="true" Hideable="true" Filterable="false"
                            SortBy="@_noClientSort" HeaderStyle="width: 80px;">
                <CellTemplate>
                    <span class="log-cell-level level-@GetLogLevelClass(context.Item.Level)">@context.Item.Level.ToUpper()</span>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Facility" Title="@_facilityLabel"
                            Sortable="true" Hideable="true" Filterable="false"
                            SortBy="@_noClientSort" HeaderStyle="width: 120px;" CellClass="log-cell-facility">
                <CellTemplate>
                    @($"[{context.Item.Facility}]")
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.Message" Title="@_messageLabel"
                            Sortable="true" Hideable="true" Filterable="false"
                            SortBy="@_noClientSort" CellClass="log-cell-message">
                <CellTemplate>
                    @context.Item.Message
                </CellTemplate>
            </PropertyColumn>
        </Columns>
    </MudDataGrid>
</div>
</div>

<style>
    .logs-fill {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - var(--mud-appbar-height, 64px) - 32px);
        overflow: hidden;
    }

    .logs-fill .mud-table {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .logs-fill .mud-table .mud-table-container {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .logs-fill .mud-data-grid .mud-toolbar {
        min-height: 36px;
        height: 36px;
    }

    .logs-fill .mud-data-grid .mud-toolbar .mud-toolbar-content {
        height: 36px;
        min-height: 36px;
    }

    .log-grid td {
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 12px;
    }

    .log-cell-time { color: var(--mud-palette-text-secondary); white-space: nowrap; }
    .log-cell-level { font-weight: bold; white-space: nowrap; }
    .log-cell-facility { color: var(--mud-palette-primary); white-space: nowrap; }
    .log-cell-message { overflow-wrap: anywhere; }

    .log-cell-level.level-error { color: var(--mud-palette-error); }
    .log-cell-level.level-warning { color: var(--mud-palette-warning); }
    .log-cell-level.level-info { color: var(--mud-palette-info); }
    .log-cell-level.level-debug { color: var(--mud-palette-text-secondary); }
</style>

@code {
    private readonly Func<LogEntry, object?> _noClientSort = _ => 0;

    private readonly CancellationTokenSource _pageCts = new();

    private MudDataGrid<LogEntry>? _grid;

    private bool _liveTail = true;
    private string _selectedLogLevel = "all";
    private string _selectedFacility = "all";
    private string _searchText = string.Empty;

    private string _timeLabel = "";
    private string _levelLabel = "";
    private string _facilityLabel = "";
    private string _messageLabel = "";

    private volatile bool _liveDirty;
    private System.Threading.Timer? _liveTimer;

    protected override void OnInitialized()
    {
        _timeLabel = L["SystemLog_Timestamp"];
        _levelLabel = L["SystemLog_Level"];
        _facilityLabel = L["SystemLog_Facility"];
        _messageLabel = L["SystemLog_Message"];

        SignalR.OnLogEntry += OnLogEntry;
        _liveTimer = new System.Threading.Timer(_ => LiveTick(), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task<GridData<LogEntry>> LoadServerData(GridStateVirtualize<LogEntry> state, CancellationToken token)
    {
        var sortColumn = "time";
        var sortDir = "desc";
        var sort = state.SortDefinitions?.FirstOrDefault();
        if (sort is not null)
        {
            sortColumn = sort.SortBy switch
            {
                "Level" => "level",
                "Facility" => "facility",
                "Message" => "message",
                _ => "time"
            };
            sortDir = sort.Descending ? "desc" : "asc";
        }

        string? filtersJson = null;
        if (state.FilterDefinitions is not null && state.FilterDefinitions.Any())
        {
            var list = new List<object>();
            foreach (var fd in state.FilterDefinitions)
            {
                if (fd.Column?.PropertyName != "Timestamp")
                {
                    continue;
                }
                var value = fd.Value is DateTime dt
                    ? dt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss")
                    : fd.Value?.ToString();
                list.Add(new { f = "timestamp", o = fd.Operator, v = value });
            }
            if (list.Count > 0)
            {
                filtersJson = System.Text.Json.JsonSerializer.Serialize(list);
            }
        }

        try
        {
            var (total, items) = await ApiClient.GetSystemLogPageAsync(
                state.StartIndex, state.Count,
                _selectedLogLevel, _selectedFacility, _searchText,
                sortColumn, sortDir, filtersJson, token);

            return new GridData<LogEntry> { Items = items, TotalItems = total };
        }
        catch (OperationCanceledException)
        {
            return new GridData<LogEntry> { Items = Array.Empty<LogEntry>(), TotalItems = 0 };
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            return new GridData<LogEntry> { Items = Array.Empty<LogEntry>(), TotalItems = 0 };
        }
    }

    private void OnLogEntry(LogEntry entry)
    {
        if (_liveTail)
        {
            _liveDirty = true;
        }
    }

    private void LiveTick()
    {
        if (!_liveDirty || !_liveTail || _grid is null)
        {
            return;
        }

        _liveDirty = false;
        InvokeAsync(async () => await _grid.ReloadServerData());
    }

    private async Task ReloadGrid()
    {
        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }
    }

    private async Task DownloadLogs()
    {
        try
        {
            var (_, items) = await ApiClient.GetSystemLogPageAsync(
                0, 5000, _selectedLogLevel, _selectedFacility, _searchText, "time", "desc");

            var content = string.Join("\n", items.Select(l =>
                $"{l.Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{l.Level}] [{l.Facility}] {l.Message}"));

            var fileName = $"creatiohelper-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
            await DownloadService.SaveTextAsync(fileName, content);
            Snackbar.Add(L["Msg_LogsDownloaded"], Severity.Success);
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            Snackbar.Add(L["Msg_FailedToDownloadLogs", ErrorHelper.GetUserFriendlyMessage(ex)], Severity.Error);
        }
    }

    private string GetLogLevelClass(string level)
    {
        return level.ToLower() switch
        {
            "error" or "fatal" => "error",
            "warning" or "warn" => "warning",
            "info" or "information" => "info",
            "debug" or "verbose" => "debug",
            _ => ""
        };
    }

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
        SignalR.OnLogEntry -= OnLogEntry;
        _liveTimer?.Dispose();
    }
}
