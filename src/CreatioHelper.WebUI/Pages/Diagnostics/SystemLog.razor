@page "/diagnostics/logs"
@inject IApiClient ApiClient
@inject ISignalRService SignalR
@inject ISnackbar Snackbar
@inject IStringLocalizer<Localization> L
@inject IErrorMessageHelper ErrorHelper
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>@L["SystemLog_Title"] - CreatioHelper Agent</PageTitle>

<div class="logs-fill">
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4" Class="flex-grow-1">@L["SystemLog_Title"]</MudText>
    <div class="d-flex gap-2 gradient-controls">
        <MudSwitch @bind-Value="_autoScroll"
                   Color="Color.Primary"
                   Label="@L["SystemLog_AutoScroll"]" />
        <MudSwitch @bind-Value="_liveTail"
                   Color="Color.Primary"
                   Label="@L["SystemLog_TailMode"]" />
    </div>
</div>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect @bind-Value="_selectedLogLevel"
                       @bind-Value:after="OnFilterChanged"
                       Label="@L["SystemLog_Level"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">@L["SystemLog_AllLevels"]</MudSelectItem>
                <MudSelectItem Value="@("error")">@L["SystemLog_LevelError"]</MudSelectItem>
                <MudSelectItem Value="@("warning")">@L["SystemLog_LevelWarning"]</MudSelectItem>
                <MudSelectItem Value="@("info")">@L["SystemLog_LevelInfo"]</MudSelectItem>
                <MudSelectItem Value="@("debug")">@L["SystemLog_LevelDebug"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect @bind-Value="_selectedFacility"
                       @bind-Value:after="OnFilterChanged"
                       Label="@L["SystemLog_Facility"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">@L["SystemLog_AllFacilities"]</MudSelectItem>
                <MudSelectItem Value="@("sync")">@L["SystemLog_FacilitySync"]</MudSelectItem>
                <MudSelectItem Value="@("model")">@L["SystemLog_FacilityModel"]</MudSelectItem>
                <MudSelectItem Value="@("scanner")">@L["SystemLog_FacilityScanner"]</MudSelectItem>
                <MudSelectItem Value="@("connections")">@L["SystemLog_FacilityConnections"]</MudSelectItem>
                <MudSelectItem Value="@("discover")">@L["SystemLog_FacilityDiscovery"]</MudSelectItem>
                <MudSelectItem Value="@("upnp")">@L["SystemLog_FacilityUpnp"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField @bind-Value="_searchText"
                          @bind-Value:after="OnFilterChanged"
                          Label="@L["SystemLog_Search"]"
                          Placeholder="@L["SystemLog_SearchPlaceholder"]"
                          Variant="Variant.Outlined"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          DebounceInterval="300"
                          Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="2" Class="log-viewer-container">
    <div class="log-viewer-toolbar pa-2 d-flex align-center">
        <MudText Typo="Typo.caption" Color="Color.Default">
            @string.Format(L["SystemLog_EntriesCount"], _logs.Count, _totalLogs)
        </MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" Dense="true"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                 aria-label="@L["Common_Columns"]">
            @foreach (var col in _columns)
            {
                <MudMenuItem OnClick="@(() => ToggleColumn(col.Key))">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Size="Size.Small"
                                 Icon="@(col.Visible ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" />
                        <span>@col.Label</span>
                    </div>
                </MudMenuItem>
            }
        </MudMenu>
        <MudIconButton Icon="@Icons.Material.Filled.Download"
                       Size="Size.Small"
                       OnClick="DownloadLogs"
                       aria-label="@L["SystemLog_Download"]" />
        <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep"
                       Size="Size.Small"
                       OnClick="ClearLogs"
                       aria-label="@L["SystemLog_Clear"]" />
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Size="Size.Small"
                       OnClick="RefreshLogs"
                       aria-label="@L["SystemLog_Refresh"]" />
    </div>

    <div class="log-grid-header" style="grid-template-columns:@GridTemplate();">
        @foreach (var col in VisibleColumns)
        {
            <div class="col-sortable" @onclick="@(() => SortBy(col.Key))">
                <span>@col.Label</span>
                @if (_sortColumn == col.Key)
                {
                    <MudIcon Size="Size.Small"
                             Icon="@(_sortDir == "asc" ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" />
                }
            </div>
        }
    </div>

    <div class="log-viewer @(_autoScroll ? "auto-scroll" : "")" @ref="_scrollContainer">
        <Virtualize Items="_logs" Context="log" ItemSize="28">
            <div class="log-entry @GetLogLevelClass(log.Level)" style="grid-template-columns:@GridTemplate();">
                @foreach (var col in VisibleColumns)
                {
                    @switch (col.Key)
                    {
                        case "time":
                            <span class="log-timestamp">@LocalTimeConverter.ToLocal(log.Timestamp).ToString("HH:mm:ss.fff")</span>
                            break;
                        case "level":
                            <span class="log-level">@log.Level.ToUpper()</span>
                            break;
                        case "facility":
                            <span class="log-facility">[@log.Facility]</span>
                            break;
                        case "message":
                            <span class="log-message">@log.Message</span>
                            break;
                    }
                }
            </div>
        </Virtualize>
    </div>

    @if (_loadingMore || (!_hasMore && _logs.Count > 0))
    {
        <div class="log-loadmore pa-2 d-flex align-center justify-center">
            @if (_loadingMore)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <MudText Typo="Typo.body2" Color="Color.Default">@L["Common_Loading"]</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Default">@L["Events_AllLoaded"]</MudText>
            }
        </div>
    }
</MudPaper>
</div>

<style>
    .logs-fill {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - var(--mud-appbar-height, 64px) - 32px);
        overflow: hidden;
    }

    .log-viewer-container {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
    }

    .log-viewer-toolbar {
        border-bottom: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
    }

    .log-viewer {
        flex: 1;
        /* app.css caps .log-viewer at 400px; here it has to fill the card instead */
        max-height: none;
        overflow-y: auto;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 12px;
        background: var(--mud-palette-background);
        color: var(--mud-palette-text-primary);
    }

    .log-viewer.auto-scroll {
        scroll-behavior: smooth;
    }

    .log-grid-header {
        display: grid;
        gap: 8px;
        align-items: center;
        padding: 6px 8px;
        border-bottom: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
        font-weight: 600;
        font-size: 12px;
    }

    .log-grid-header .col-sortable {
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .log-grid-header .col-sortable:hover {
        color: var(--mud-palette-primary);
    }

    .log-entry {
        display: grid;
        gap: 8px;
        align-items: start;
        padding: 2px 8px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
        /* Long file paths would otherwise stretch the list far past the viewport,
           leaving a horizontal scrollbar and empty space next to the shorter rows */
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .log-entry:hover {
        background: var(--mud-palette-action-default-hover);
    }

    .log-timestamp {
        color: var(--mud-palette-text-secondary);
    }

    .log-level {
        font-weight: bold;
    }

    .log-facility {
        color: var(--mud-palette-primary);
    }

    .log-entry.error .log-level { color: var(--mud-palette-error); }
    .log-entry.warning .log-level { color: var(--mud-palette-warning); }
    .log-entry.info .log-level { color: var(--mud-palette-info); }
    .log-entry.debug .log-level { color: var(--mud-palette-text-secondary); }
</style>

@code {
    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;

    private const int BatchSize = 100;

    private sealed class Column
    {
        public string Key { get; init; } = "";
        public string Label { get; init; } = "";
        public string Width { get; init; } = "1fr";
        public bool Visible { get; set; } = true;
    }

    private readonly CancellationTokenSource _pageCts = new();

    private bool _autoScroll = true;
    private bool _liveTail = true;
    private string _selectedLogLevel = "all";
    private string _selectedFacility = "all";
    private string _searchText = string.Empty;

    private string _sortColumn = "time";
    private string _sortDir = "desc";
    private List<Column> _columns = new();

    private readonly List<LogEntry> _logs = new();
    private int _totalLogs;
    private bool _loadingMore;
    private bool _hasMore = true;

    private volatile bool _liveDirty;
    private System.Threading.Timer? _liveTimer;

    private ElementReference _scrollContainer;
    private DotNetObjectReference<SystemLog>? _selfRef;
    private int _scrollHandle;

    private IEnumerable<Column> VisibleColumns => _columns.Where(c => c.Visible);

    private string GridTemplate() => string.Join(" ", VisibleColumns.Select(c => c.Width));

    protected override async Task OnInitializedAsync()
    {
        _columns = new()
        {
            new Column { Key = "time", Label = L["SystemLog_Timestamp"], Width = "130px" },
            new Column { Key = "level", Label = L["SystemLog_Level"], Width = "70px" },
            new Column { Key = "facility", Label = L["SystemLog_Facility"], Width = "120px" },
            new Column { Key = "message", Label = L["SystemLog_Message"], Width = "minmax(0,1fr)" },
        };

        SignalR.OnLogEntry += OnLogEntry;
        _liveTimer = new System.Threading.Timer(_ => LiveTick(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        await LoadInitial();
    }

    private async Task SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDir = _sortDir == "asc" ? "desc" : "asc";
        }
        else
        {
            _sortColumn = column;
            _sortDir = "desc";
        }

        _hasMore = true;
        await LoadInitial();
        await ScrollToTop();
    }

    private void ToggleColumn(string key)
    {
        var col = _columns.FirstOrDefault(c => c.Key == key);
        if (col is null)
        {
            return;
        }

        if (col.Visible && _columns.Count(c => c.Visible) <= 1)
        {
            return;
        }

        col.Visible = !col.Visible;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollHandle != 0 || string.IsNullOrEmpty(_scrollContainer.Id))
        {
            return;
        }

        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _scrollHandle = await JSRuntime.InvokeAsync<int>(
                "creatioInfiniteScroll.attach",
                _scrollContainer,
                _selfRef,
                nameof(OnScrolledNearBottom),
                1.5);
        }
        catch (JSException)
        {
        }
    }

    private void OnLogEntry(LogEntry entry)
    {
        if (_liveTail)
        {
            _liveDirty = true;
        }
    }

    private void LiveTick()
    {
        if (!_liveDirty || !_liveTail)
        {
            return;
        }

        InvokeAsync(async () =>
        {
            if (!await IsScrolledToTop())
            {
                return;
            }

            _liveDirty = false;
            await LoadInitial();
        });
    }

    private async Task<bool> IsScrolledToTop()
    {
        try
        {
            return await JSRuntime.InvokeAsync<bool>("eval", "(document.querySelector('.log-viewer')?.scrollTop ?? 999) < 40");
        }
        catch
        {
            return true;
        }
    }

    private async Task LoadInitial()
    {
        try
        {
            var (total, items) = await ApiClient.GetSystemLogPageAsync(
                0, BatchSize, _selectedLogLevel, _selectedFacility, _searchText, _sortColumn, _sortDir, _pageCts.Token);

            _logs.Clear();
            _logs.AddRange(items);
            _totalLogs = total;
            _hasMore = _logs.Count < total;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
    }

    [JSInvokable]
    public async Task<bool> OnScrolledNearBottom()
    {
        if (!_hasMore || _loadingMore)
        {
            return false;
        }

        _loadingMore = true;
        StateHasChanged();

        try
        {
            var (total, items) = await ApiClient.GetSystemLogPageAsync(
                _logs.Count, BatchSize, _selectedLogLevel, _selectedFacility, _searchText, _sortColumn, _sortDir, _pageCts.Token);

            if (items.Length == 0)
            {
                _hasMore = false;
            }
            else
            {
                _logs.AddRange(items);
                _totalLogs = total;
                _hasMore = _logs.Count < total;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return false;
            }
        }
        finally
        {
            _loadingMore = false;
            StateHasChanged();
        }

        return _hasMore;
    }

    private async Task OnFilterChanged()
    {
        _hasMore = true;
        await LoadInitial();
        await ScrollToTop();
    }

    private async Task RefreshLogs()
    {
        _hasMore = true;
        await LoadInitial();
        await ScrollToTop();
    }

    private string GetLogLevelClass(string level)
    {
        return level.ToLower() switch
        {
            "error" or "fatal" => "error",
            "warning" or "warn" => "warning",
            "info" or "information" => "info",
            "debug" or "verbose" => "debug",
            _ => ""
        };
    }

    private async Task ScrollToTop()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "document.querySelector('.log-viewer')?.scrollTo(0, 0)");
        }
        catch { }
    }

    private async Task ClearLogs()
    {
        await RefreshLogs();
    }

    private async Task DownloadLogs()
    {
        try
        {
            var (_, items) = await ApiClient.GetSystemLogPageAsync(
                0, 5000, _selectedLogLevel, _selectedFacility, _searchText);

            var content = string.Join("\n", items.Select(l =>
                $"{l.Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{l.Level}] [{l.Facility}] {l.Message}"));

            var bytes = System.Text.Encoding.UTF8.GetBytes(content);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"creatiohelper-logs-{DateTime.Now:yyyyMMdd-HHmmss}.txt";

            await JSRuntime.InvokeVoidAsync("eval",
                $"const link = document.createElement('a'); " +
                $"link.href = 'data:text/plain;base64,{base64}'; " +
                $"link.download = '{fileName}'; " +
                $"link.click();");

            Snackbar.Add(L["Msg_LogsDownloaded"], Severity.Success);
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
            Snackbar.Add(L["Msg_FailedToDownloadLogs", ErrorHelper.GetUserFriendlyMessage(ex)], Severity.Error);
        }
    }

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
        SignalR.OnLogEntry -= OnLogEntry;
        _liveTimer?.Dispose();

        if (_scrollHandle != 0)
        {
            _ = JSRuntime.InvokeVoidAsync("creatioInfiniteScroll.detach", _scrollHandle);
        }

        _selfRef?.Dispose();
    }
}
