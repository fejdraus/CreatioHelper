@page "/monitoring/events"
@inject IApiClient ApiClient
@inject ISignalRService SignalR
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<Localization> L
@inject IErrorMessageHelper ErrorHelper
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>@L["Events_Title"] - CreatioHelper Agent</PageTitle>

<style>
    .events-fill {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - var(--mud-appbar-height, 64px) - 32px);
        overflow: hidden;
    }

    .event-viewer-container {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
        min-height: 0;
        position: relative;
    }

    .event-grid-header {
        display: grid;
        gap: 8px;
        align-items: center;
        padding: 8px 12px;
        border-bottom: 1px solid var(--mud-palette-divider);
        background: var(--mud-palette-surface);
        font-weight: 600;
        font-size: 0.8125rem;
    }

    .event-grid-header .col-sortable {
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .event-grid-header .col-sortable:hover {
        color: var(--mud-palette-primary);
    }

    .event-viewer {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .event-row {
        display: grid;
        gap: 8px;
        align-items: center;
        padding: 6px 12px;
        border-bottom: 1px solid var(--mud-palette-lines-default);
    }

    .event-row:hover {
        background: var(--mud-palette-action-default-hover);
    }

    .event-details {
        overflow-wrap: anywhere;
    }

    .event-loadmore {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8px;
        border-top: 1px solid var(--mud-palette-divider);
    }

    .event-empty-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        pointer-events: none;
    }
</style>

<div class="events-fill">
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4" Class="flex-grow-1">@L["Events_Title"]</MudText>
    <div class="d-flex align-center gap-2 gradient-controls">
        <MudMenu Icon="@Icons.Material.Filled.ViewColumn" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Label="@L["Common_Columns"]">
            @foreach (var col in _columns)
            {
                <MudMenuItem OnClick="@(() => ToggleColumn(col.Key))">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Size="Size.Small"
                                 Icon="@(col.Visible ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)" />
                        <span>@col.Label</span>
                    </div>
                </MudMenuItem>
            }
        </MudMenu>
        <MudSwitch @bind-Value="_liveUpdates"
                   Color="Color.Primary"
                   Label="@L["Events_LiveUpdates"]" />
    </div>
</div>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Value="_selectedEventType"
                       ValueChanged="OnEventTypeChanged"
                       Label="@L["Events_FilterByType"]"
                       Variant="Variant.Outlined"
                       Dense="true">
                <MudSelectItem Value="@("all")">@L["Events_AllTypes"]</MudSelectItem>
                <MudSelectItem Value="@("StateChanged")">@L["EventType_StateChanged"]</MudSelectItem>
                <MudSelectItem Value="@("ItemStarted")">@L["EventType_ItemStarted"]</MudSelectItem>
                <MudSelectItem Value="@("ItemFinished")">@L["EventType_ItemFinished"]</MudSelectItem>
                <MudSelectItem Value="@("FolderCompletion")">@L["EventType_FolderCompletion"]</MudSelectItem>
                <MudSelectItem Value="@("DeviceConnected")">@L["EventType_DeviceConnected"]</MudSelectItem>
                <MudSelectItem Value="@("DeviceDisconnected")">@L["EventType_DeviceDisconnected"]</MudSelectItem>
                <MudSelectItem Value="@("FolderErrors")">@L["EventType_FolderErrors"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Value="_selectedFolder"
                       ValueChanged="OnFolderChanged"
                       Label="@L["Common_Folder"]"
                       Variant="Variant.Outlined"
                       Dense="true">
                <MudSelectItem Value="@("all")">@L["Events_AllFolders"]</MudSelectItem>
                @foreach (var folder in _folders)
                {
                    <MudSelectItem Value="@folder.Id">@folder.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Value="_selectedDevice"
                       ValueChanged="OnDeviceChanged"
                       Label="@L["Common_Device"]"
                       Variant="Variant.Outlined"
                       Dense="true">
                <MudSelectItem Value="@("all")">@L["Events_AllDevices"]</MudSelectItem>
                @foreach (var device in _devices)
                {
                    <MudSelectItem Value="@device.DeviceId">@device.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="2" Class="event-viewer-container">
    <div class="event-grid-header" style="grid-template-columns:@GridTemplate();">
        @foreach (var col in VisibleColumns)
        {
            if (col.Sortable)
            {
                <div class="col-sortable" @onclick="@(() => SortBy(col.Key))">
                    <span>@col.Label</span>
                    @if (_sortColumn == col.Key)
                    {
                        <MudIcon Size="Size.Small"
                                 Icon="@(_sortDir == "asc" ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)" />
                    }
                </div>
            }
            else
            {
                <div>@col.Label</div>
            }
        }
        <div></div>
    </div>

    <div class="event-viewer" @ref="_scrollContainer">
        <Virtualize Items="_events" Context="evt" ItemSize="44">
            <div class="event-row" style="grid-template-columns:@GridTemplate();">
                @foreach (var col in VisibleColumns)
                {
                    <div class="@(col.Key == "data" ? "event-details" : "")">
                        @switch (col.Key)
                        {
                            case "time":
                                <MudText Typo="Typo.body2">@LocalTimeConverter.ToLocal(evt.Timestamp).ToString("HH:mm:ss")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Default">@LocalTimeConverter.ToLocal(evt.Timestamp).ToString("yyyy-MM-dd")</MudText>
                                break;
                            case "type":
                                <MudChip T="string" Size="Size.Small" Color="@GetEventColor(evt)" Variant="Variant.Outlined">
                                    @GetEventTypeDisplay(evt.Type)
                                </MudChip>
                                break;
                            case "data":
                                @GetEventDescription(evt)
                                break;
                        }
                    </div>
                }
                <div>
                    @if (CanNavigate(evt))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Size="Size.Small"
                                       OnClick="@(() => NavigateToRelated(evt))" />
                    }
                </div>
            </div>
        </Virtualize>
    </div>

    @if (_loadingMore || (!_hasMore && _events.Count > 0))
    {
        <div class="event-loadmore">
            @if (_loadingMore)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <MudText Typo="Typo.body2" Color="Color.Default">@L["Common_Loading"]</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Default">@L["Events_AllLoaded"]</MudText>
            }
        </div>
    }

    @if (_initialLoaded && _events.Count == 0)
    {
        <div class="event-empty-overlay">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Default" Class="mb-4" />
            <MudText Typo="Typo.h6" Class="mb-2">@L["Events_NoEvents"]</MudText>
            <MudText Color="Color.Default">@L["Events_WaitingForEvents"]</MudText>
        </div>
    }
</MudPaper>
</div>

@code {
    private const int BatchSize = 60;

    private sealed class Column
    {
        public string Key { get; init; } = "";
        public string Label { get; init; } = "";
        public bool Sortable { get; init; }
        public string Width { get; init; } = "1fr";
        public bool Visible { get; set; } = true;
    }

    private readonly CancellationTokenSource _pageCts = new();

    private bool _liveUpdates = true;
    private bool _initialLoaded;
    private bool _loadingMore;
    private bool _hasMore = true;

    private string _selectedEventType = "all";
    private string _selectedFolder = "all";
    private string _selectedDevice = "all";

    private string _sortColumn = "time";
    private string _sortDir = "desc";

    private List<Column> _columns = new();

    private FolderConfig[] _folders = [];
    private DeviceConfig[] _devices = [];

    private readonly List<SyncEvent> _events = new();
    private int _totalEvents;

    private volatile bool _liveDirty;
    private System.Threading.Timer? _liveTimer;

    private ElementReference _scrollContainer;
    private DotNetObjectReference<Events>? _selfRef;
    private int _scrollHandle;

    private IEnumerable<Column> VisibleColumns => _columns.Where(c => c.Visible);

    private string GridTemplate()
    {
        var widths = string.Join(" ", VisibleColumns.Select(c => c.Width));
        return string.IsNullOrEmpty(widths) ? "48px" : widths + " 48px";
    }

    protected override async Task OnInitializedAsync()
    {
        _columns = new()
        {
            new Column { Key = "time", Label = L["Events_Time"], Sortable = true, Width = "160px" },
            new Column { Key = "type", Label = L["Events_EventType"], Sortable = true, Width = "140px" },
            new Column { Key = "data", Label = L["Events_Data"], Sortable = false, Width = "minmax(0,1fr)" },
        };

        SignalR.OnSyncEvent += OnSyncEvent;
        _liveTimer = new System.Threading.Timer(_ => LiveTick(), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        try
        {
            _folders = await ApiClient.GetFoldersAsync(_pageCts.Token);
            _devices = await ApiClient.GetDevicesAsync(_pageCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }
        }

        await LoadInitial();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollHandle != 0 || string.IsNullOrEmpty(_scrollContainer.Id))
        {
            return;
        }

        try
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _scrollHandle = await JS.InvokeAsync<int>(
                "creatioInfiniteScroll.attach",
                _scrollContainer,
                _selfRef,
                nameof(OnScrolledNearBottom),
                1.5);
        }
        catch (JSException)
        {
        }
    }

    private async Task LoadInitial()
    {
        try
        {
            var (total, items) = await ApiClient.GetEventsPageAsync(
                0, BatchSize, _selectedEventType, _selectedFolder, _selectedDevice, _sortColumn, _sortDir, _pageCts.Token);

            _events.Clear();
            _events.AddRange(items);
            _totalEvents = total;
            _hasMore = _events.Count < total;
            _initialLoaded = true;
            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
    }

    [JSInvokable]
    public async Task<bool> OnScrolledNearBottom()
    {
        if (!_hasMore || _loadingMore)
        {
            return false;
        }

        _loadingMore = true;
        StateHasChanged();

        try
        {
            var (total, items) = await ApiClient.GetEventsPageAsync(
                _events.Count, BatchSize, _selectedEventType, _selectedFolder, _selectedDevice, _sortColumn, _sortDir, _pageCts.Token);

            if (items.Length == 0)
            {
                _hasMore = false;
            }
            else
            {
                _events.AddRange(items);
                _totalEvents = total;
                _hasMore = _events.Count < total;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return false;
            }
        }
        finally
        {
            _loadingMore = false;
            StateHasChanged();
        }

        return _hasMore;
    }

    private void OnSyncEvent(SyncEvent evt)
    {
        if (_liveUpdates)
        {
            _liveDirty = true;
        }
    }

    private void LiveTick()
    {
        if (!_liveDirty || !_liveUpdates)
        {
            return;
        }

        InvokeAsync(async () =>
        {
            if (!await IsScrolledToTop())
            {
                return;
            }

            _liveDirty = false;
            await LoadInitial();
        });
    }

    private async Task<bool> IsScrolledToTop()
    {
        try
        {
            return await JS.InvokeAsync<bool>("eval", "(document.querySelector('.event-viewer')?.scrollTop ?? 999) < 40");
        }
        catch
        {
            return true;
        }
    }

    private async Task SortBy(string column)
    {
        if (_sortColumn == column)
        {
            _sortDir = _sortDir == "asc" ? "desc" : "asc";
        }
        else
        {
            _sortColumn = column;
            _sortDir = "desc";
        }

        _hasMore = true;
        await LoadInitial();
        await ScrollToTop();
    }

    private void ToggleColumn(string key)
    {
        var col = _columns.FirstOrDefault(c => c.Key == key);
        if (col is null)
        {
            return;
        }

        if (col.Visible && _columns.Count(c => c.Visible) <= 1)
        {
            return;
        }

        col.Visible = !col.Visible;
        StateHasChanged();
    }

    private async Task OnEventTypeChanged(string value)
    {
        _selectedEventType = value;
        await ReloadFromFilter();
    }

    private async Task OnFolderChanged(string value)
    {
        _selectedFolder = value;
        await ReloadFromFilter();
    }

    private async Task OnDeviceChanged(string value)
    {
        _selectedDevice = value;
        await ReloadFromFilter();
    }

    private async Task ReloadFromFilter()
    {
        _hasMore = true;
        await LoadInitial();
        await ScrollToTop();
    }

    private async Task ScrollToTop()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.event-viewer')?.scrollTo(0, 0)");
        }
        catch
        {
        }
    }

    private Color GetEventColor(SyncEvent evt)
    {
        return evt.Type switch
        {
            EventType.FolderCompletion => Color.Success,
            EventType.ItemFinished => Color.Success,
            EventType.DiscoveryCompleted => Color.Success,
            EventType.DeviceConnected => Color.Info,
            EventType.DeviceDisconnected => Color.Warning,
            EventType.FolderErrors => Color.Error,
            EventType.StateChanged => Color.Default,
            _ => Color.Default
        };
    }

    private string GetEventTypeDisplay(EventType type)
    {
        return EventTypeDisplay.Format(type, L);
    }

    private string GetEventDescription(SyncEvent evt)
    {
        var folder = _folders.FirstOrDefault(f => f.Id == evt.FolderId)?.DisplayName ?? evt.FolderId ?? "";
        var device = _devices.FirstOrDefault(d => d.DeviceId == evt.DeviceId)?.DisplayName ?? evt.DeviceId ?? "";

        var deviceDisplay = device;
        var folderDisplay = folder;

        return evt.Type switch
        {
            EventType.FolderCompletion => L["EventDesc_FolderCompletion", folderDisplay, deviceDisplay],
            EventType.ItemFinished => L["EventDesc_ItemFinished", evt.FileName ?? "", folderDisplay],
            EventType.ItemStarted => L["EventDesc_ItemStarted", evt.FileName ?? "", folderDisplay],
            EventType.DeviceConnected => L["EventDesc_DeviceConnected", deviceDisplay],
            EventType.DeviceDisconnected => L["EventDesc_DeviceDisconnected", deviceDisplay],
            EventType.FolderErrors => L["EventDesc_FolderErrors", folderDisplay, evt.Error ?? ""],
            EventType.StateChanged => L["EventDesc_StateChanged", evt.From ?? "", evt.To ?? ""],
            EventType.Starting => L["EventDesc_Starting"],
            EventType.StartupComplete => L["EventDesc_StartupComplete"],
            EventType.FolderWatchStateChanged => L["EventDesc_WatchStateChanged", folderDisplay],
            EventType.DevicePaused => L["EventDesc_DevicePaused", deviceDisplay],
            EventType.DeviceResumed => L["EventDesc_DeviceResumed", deviceDisplay],
            EventType.FolderPaused => L["EventDesc_FolderPaused", folderDisplay],
            EventType.FolderResumed => L["EventDesc_FolderResumed", folderDisplay],
            EventType.LocalChangeDetected => L["EventDesc_LocalChange", evt.FileName ?? ""],
            EventType.RemoteChangeDetected => L["EventDesc_RemoteChange", evt.FileName ?? "", deviceDisplay],
            EventType.ConfigSaved => L["EventDesc_ConfigSaved"],
            EventType.DiscoveryCompleted => GetDiscoveryCompletedDescription(evt, folderDisplay),
            EventType.Unknown => !string.IsNullOrEmpty(evt.Message) ? evt.Message : $"{L["EventDesc_UnknownEvent"]}: {evt.RawType}",
            _ => !string.IsNullOrEmpty(evt.Message) ? evt.Message : evt.RawType
        };
    }

    private string GetDiscoveryCompletedDescription(SyncEvent evt, string folderDisplay)
    {
        if (!string.IsNullOrEmpty(evt.FolderId))
        {
            return L["EventDesc_DiscoveryCompleted", folderDisplay];
        }

        var totalFiles = evt.GetDataValue("totalFiles");
        var totalSize = evt.GetDataValue("totalSize");

        if (!string.IsNullOrEmpty(totalFiles) && !string.IsNullOrEmpty(totalSize))
        {
            return L["EventDesc_DiscoveryCompletedGlobal", totalFiles, FormatBytes(long.TryParse(totalSize, out var size) ? size : 0)];
        }

        return L["EventDesc_DiscoveryCompletedSimple"];
    }

    private string FormatBytes(long bytes)
    {
        return ByteFormatter.Format(bytes, L);
    }

    private bool CanNavigate(SyncEvent evt)
    {
        return !string.IsNullOrEmpty(evt.FolderId) || !string.IsNullOrEmpty(evt.DeviceId);
    }

    private void NavigateToRelated(SyncEvent evt)
    {
        if (!string.IsNullOrEmpty(evt.FolderId))
        {
            Navigation.NavigateTo("/folders");
        }
        else if (!string.IsNullOrEmpty(evt.DeviceId))
        {
            Navigation.NavigateTo($"/devices/{evt.DeviceId}");
        }
    }

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
        SignalR.OnSyncEvent -= OnSyncEvent;
        _liveTimer?.Dispose();

        if (_scrollHandle != 0)
        {
            _ = JS.InvokeVoidAsync("creatioInfiniteScroll.detach", _scrollHandle);
        }

        _selfRef?.Dispose();
    }
}
