@page "/monitoring/events"
@inject IApiClient ApiClient
@inject ISignalRService SignalR
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IStringLocalizer<Localization> L
@inject IErrorMessageHelper ErrorHelper
@inject IFileDownloadService DownloadService
@implements IDisposable

<PageTitle>@L["Events_Title"] - CreatioHelper Agent</PageTitle>

<style>
    .events-fill {
        display: flex;
        flex-direction: column;
        height: calc(100dvh - var(--mud-appbar-height, 64px) - 32px);
        overflow: hidden;
    }

    .events-fill .mud-table {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
    }

    .events-fill .mud-table .mud-table-container {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
    }

    .event-details {
        overflow-wrap: anywhere;
    }

    .events-fill .mud-data-grid .mud-toolbar {
        min-height: 36px;
        height: 36px;
    }

    .events-fill .mud-data-grid .mud-toolbar .mud-toolbar-content {
        height: 36px;
        min-height: 36px;
    }
</style>

<div class="events-fill">
<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4" Class="flex-grow-1">@L["Events_Title"]</MudText>
    <div class="gradient-controls">
        <MudSwitch @bind-Value="_liveUpdates"
                   Color="Color.Primary"
                   Label="@L["Events_LiveUpdates"]" />
    </div>
</div>

<MudPaper Elevation="2" Class="pa-4 mb-2">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Value="_selectedEventType"
                       ValueChanged="OnEventTypeChanged"
                       Label="@L["Events_FilterByType"]"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">@L["Events_AllTypes"]</MudSelectItem>
                <MudSelectItem Value="@("StateChanged")">@L["EventType_StateChanged"]</MudSelectItem>
                <MudSelectItem Value="@("ItemStarted")">@L["EventType_ItemStarted"]</MudSelectItem>
                <MudSelectItem Value="@("ItemFinished")">@L["EventType_ItemFinished"]</MudSelectItem>
                <MudSelectItem Value="@("FolderCompletion")">@L["EventType_FolderCompletion"]</MudSelectItem>
                <MudSelectItem Value="@("DeviceConnected")">@L["EventType_DeviceConnected"]</MudSelectItem>
                <MudSelectItem Value="@("DeviceDisconnected")">@L["EventType_DeviceDisconnected"]</MudSelectItem>
                <MudSelectItem Value="@("FolderErrors")">@L["EventType_FolderErrors"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Value="_selectedFolder"
                       ValueChanged="OnFolderChanged"
                       Label="@L["Common_Folder"]"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">@L["Events_AllFolders"]</MudSelectItem>
                @foreach (var folder in _folders)
                {
                    <MudSelectItem Value="@folder.Id">@folder.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Value="_selectedDevice"
                       ValueChanged="OnDeviceChanged"
                       Label="@L["Common_Device"]"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@("all")">@L["Events_AllDevices"]</MudSelectItem>
                @foreach (var device in _devices)
                {
                    <MudSelectItem Value="@device.DeviceId">@device.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<div class="d-flex flex-column" style="flex:1 1 auto; min-height:0;">
    <MudDataGrid T="SyncEvent"
                 @ref="_grid"
                 VirtualizeServerData="LoadServerData"
                 Dense="true"
                 Hover="true"
                 FixedHeader="true"
                 Virtualize="true"
                 SortMode="SortMode.Single"
                 Filterable="true"
                 FilterMode="DataGridFilterMode.ColumnFilterMenu"
                 ShowMenuIcon="true"
                 Height="100%"
                 Elevation="2">
        <ToolBarContent>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Download"
                           Size="Size.Small"
                           OnClick="DownloadEvents"
                           aria-label="@L["SystemLog_Download"]" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           OnClick="ReloadGrid"
                           aria-label="@L["SystemLog_Refresh"]" />
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Timestamp" Title="@_timeLabel"
                            Sortable="true" Hideable="true" Filterable="true"
                            InitialDirection="SortDirection.Descending"
                            SortBy="@_noClientSort" HeaderStyle="width: 160px;">
                <CellTemplate>
                    <MudText Typo="Typo.body2">@LocalTimeConverter.ToLocal(context.Item.Timestamp).ToString("HH:mm:ss")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Default">@DateFormatter.FormatDate(LocalTimeConverter.ToLocal(context.Item.Timestamp))</MudText>
                </CellTemplate>
            </PropertyColumn>
            <PropertyColumn Property="x => x.RawType" Title="@_typeLabel"
                            Sortable="true" Hideable="true" Filterable="false"
                            SortBy="@_noClientSort" HeaderStyle="width: 180px; white-space: nowrap;">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" Color="@GetEventColor(context.Item)" Variant="Variant.Outlined">
                        @GetEventTypeDisplay(context.Item.Type)
                    </MudChip>
                </CellTemplate>
            </PropertyColumn>
            <TemplateColumn Title="@_dataLabel" Sortable="false" Filterable="false" Hideable="true">
                <CellTemplate>
                    <span class="event-details">@GetEventDescription(context.Item)</span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Filterable="false" Hideable="false" HeaderStyle="width: 50px;">
                <CellTemplate>
                    @if (CanNavigate(context.Item))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Size="Size.Small"
                                       OnClick="@(() => NavigateToRelated(context.Item))" />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
</div>
</div>

@code {
    private readonly Func<SyncEvent, object?> _noClientSort = _ => 0;

    private readonly CancellationTokenSource _pageCts = new();

    private MudDataGrid<SyncEvent>? _grid;

    private bool _liveUpdates = true;

    private string _selectedEventType = "all";
    private string _selectedFolder = "all";
    private string _selectedDevice = "all";
    private string _searchText = string.Empty;

    private string _timeLabel = "";
    private string _typeLabel = "";
    private string _dataLabel = "";

    private FolderConfig[] _folders = [];
    private DeviceConfig[] _devices = [];

    private volatile bool _liveDirty;
    private System.Threading.Timer? _liveTimer;

    protected override async Task OnInitializedAsync()
    {
        _timeLabel = L["Events_Time"];
        _typeLabel = L["Events_EventType"];
        _dataLabel = L["Events_Data"];

        SignalR.OnSyncEvent += OnSyncEvent;
        _liveTimer = new System.Threading.Timer(_ => LiveTick(), null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));

        try
        {
            _folders = await ApiClient.GetFoldersAsync(_pageCts.Token);
            _devices = await ApiClient.GetDevicesAsync(_pageCts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
    }

    private async Task<GridData<SyncEvent>> LoadServerData(GridStateVirtualize<SyncEvent> state, CancellationToken token)
    {
        var sortColumn = "time";
        var sortDir = "desc";
        var sort = state.SortDefinitions?.FirstOrDefault();
        if (sort is not null)
        {
            sortColumn = sort.SortBy switch { "RawType" => "type", _ => "time" };
            sortDir = sort.Descending ? "desc" : "asc";
        }

        string? filtersJson = null;
        if (state.FilterDefinitions is not null && state.FilterDefinitions.Any())
        {
            var list = new List<object>();
            foreach (var fd in state.FilterDefinitions)
            {
                if (fd.Column?.PropertyName != "Timestamp")
                {
                    continue;
                }
                var value = fd.Value is DateTime dt
                    ? dt.ToUniversalTime().ToString("yyyy-MM-ddTHH:mm:ss")
                    : fd.Value?.ToString();
                list.Add(new { f = "timestamp", o = fd.Operator, v = value });
            }
            if (list.Count > 0)
            {
                filtersJson = System.Text.Json.JsonSerializer.Serialize(list);
            }
        }

        try
        {
            var (total, items) = await ApiClient.GetEventsPageAsync(
                state.StartIndex, state.Count,
                _selectedEventType, _selectedFolder, _selectedDevice, _searchText,
                sortColumn, sortDir, filtersJson, token);

            return new GridData<SyncEvent> { Items = items, TotalItems = total };
        }
        catch (OperationCanceledException)
        {
            return new GridData<SyncEvent> { Items = Array.Empty<SyncEvent>(), TotalItems = 0 };
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
            return new GridData<SyncEvent> { Items = Array.Empty<SyncEvent>(), TotalItems = 0 };
        }
    }

    private void OnSyncEvent(SyncEvent evt)
    {
        if (_liveUpdates)
        {
            _liveDirty = true;
        }
    }

    private void LiveTick()
    {
        if (!_liveDirty || !_liveUpdates || _grid is null)
        {
            return;
        }

        _liveDirty = false;
        InvokeAsync(async () => await _grid.ReloadServerData());
    }

    private async Task OnEventTypeChanged(string value)
    {
        _selectedEventType = value;
        await ReloadGrid();
    }

    private async Task OnFolderChanged(string value)
    {
        _selectedFolder = value;
        await ReloadGrid();
    }

    private async Task OnDeviceChanged(string value)
    {
        _selectedDevice = value;
        await ReloadGrid();
    }

    private async Task OnFilterChanged()
    {
        await ReloadGrid();
    }

    private async Task ReloadGrid()
    {
        if (_grid is not null)
        {
            await _grid.ReloadServerData();
        }
    }

    private async Task DownloadEvents()
    {
        try
        {
            var (_, items) = await ApiClient.GetEventsPageAsync(
                0, 5000, _selectedEventType, _selectedFolder, _selectedDevice, _searchText, "time", "desc");

            var content = string.Join("\n", items.Select(e =>
                $"{LocalTimeConverter.ToLocal(e.Timestamp):yyyy-MM-dd HH:mm:ss} [{GetEventTypeDisplay(e.Type)}] {GetEventDescription(e)}"));

            var fileName = $"creatiohelper-events-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
            await DownloadService.SaveTextAsync(fileName, content);
        }
        catch (Exception ex)
        {
            if (ErrorHelper.IsAuthenticationError(ex))
            {
                Navigation.NavigateTo("/login", forceLoad: true);
            }
        }
    }

    private Color GetEventColor(SyncEvent evt)
    {
        return evt.Type switch
        {
            EventType.FolderCompletion => Color.Success,
            EventType.ItemFinished => Color.Success,
            EventType.DiscoveryCompleted => Color.Success,
            EventType.DeviceConnected => Color.Info,
            EventType.DeviceDisconnected => Color.Warning,
            EventType.FolderErrors => Color.Error,
            EventType.StateChanged => Color.Default,
            _ => Color.Default
        };
    }

    private string GetEventTypeDisplay(EventType type)
    {
        return EventTypeDisplay.Format(type, L);
    }

    private string GetEventDescription(SyncEvent evt)
    {
        var folder = _folders.FirstOrDefault(f => f.Id == evt.FolderId)?.DisplayName ?? evt.FolderId ?? "";
        var device = _devices.FirstOrDefault(d => d.DeviceId == evt.DeviceId)?.DisplayName ?? evt.DeviceId ?? "";

        var deviceDisplay = device;
        var folderDisplay = folder;

        return evt.Type switch
        {
            EventType.FolderCompletion => L["EventDesc_FolderCompletion", folderDisplay, deviceDisplay],
            EventType.ItemFinished => L["EventDesc_ItemFinished", evt.FileName ?? "", folderDisplay],
            EventType.ItemStarted => L["EventDesc_ItemStarted", evt.FileName ?? "", folderDisplay],
            EventType.DeviceConnected => L["EventDesc_DeviceConnected", deviceDisplay],
            EventType.DeviceDisconnected => L["EventDesc_DeviceDisconnected", deviceDisplay],
            EventType.FolderErrors => L["EventDesc_FolderErrors", folderDisplay, evt.Error ?? ""],
            EventType.StateChanged => L["EventDesc_StateChanged", evt.From ?? "", evt.To ?? ""],
            EventType.Starting => L["EventDesc_Starting"],
            EventType.StartupComplete => L["EventDesc_StartupComplete"],
            EventType.FolderWatchStateChanged => L["EventDesc_WatchStateChanged", folderDisplay],
            EventType.DevicePaused => L["EventDesc_DevicePaused", deviceDisplay],
            EventType.DeviceResumed => L["EventDesc_DeviceResumed", deviceDisplay],
            EventType.FolderPaused => L["EventDesc_FolderPaused", folderDisplay],
            EventType.FolderResumed => L["EventDesc_FolderResumed", folderDisplay],
            EventType.LocalChangeDetected => L["EventDesc_LocalChange", evt.FileName ?? ""],
            EventType.RemoteChangeDetected => L["EventDesc_RemoteChange", evt.FileName ?? "", deviceDisplay],
            EventType.ConfigSaved => L["EventDesc_ConfigSaved"],
            EventType.FolderScanProgress => L["EventDesc_FolderScan", folderDisplay, evt.GetDataValue("TotalFiles")],
            EventType.RemoteIndexUpdated => L["EventDesc_IndexReceived", deviceDisplay, evt.GetDataValue("FileCount")],
            EventType.LocalIndexUpdated => L["EventDesc_IndexUpdatedLocal", folderDisplay],
            EventType.DiscoveryCompleted => GetDiscoveryCompletedDescription(evt, folderDisplay),
            EventType.Unknown => !string.IsNullOrEmpty(evt.Message) ? evt.Message : $"{L["EventDesc_UnknownEvent"]}: {evt.RawType}",
            _ => !string.IsNullOrEmpty(evt.Message) ? evt.Message : evt.RawType
        };
    }

    private string GetDiscoveryCompletedDescription(SyncEvent evt, string folderDisplay)
    {
        if (!string.IsNullOrEmpty(evt.FolderId))
        {
            return L["EventDesc_DiscoveryCompleted", folderDisplay];
        }

        var totalFiles = evt.GetDataValue("totalFiles");
        var totalSize = evt.GetDataValue("totalSize");

        if (!string.IsNullOrEmpty(totalFiles) && !string.IsNullOrEmpty(totalSize))
        {
            return L["EventDesc_DiscoveryCompletedGlobal", totalFiles, FormatBytes(long.TryParse(totalSize, out var size) ? size : 0)];
        }

        return L["EventDesc_DiscoveryCompletedSimple"];
    }

    private string FormatBytes(long bytes)
    {
        return ByteFormatter.Format(bytes, L);
    }

    private bool CanNavigate(SyncEvent evt)
    {
        return !string.IsNullOrEmpty(evt.FolderId) || !string.IsNullOrEmpty(evt.DeviceId);
    }

    private void NavigateToRelated(SyncEvent evt)
    {
        if (!string.IsNullOrEmpty(evt.FolderId))
        {
            Navigation.NavigateTo("/folders");
        }
        else if (!string.IsNullOrEmpty(evt.DeviceId))
        {
            Navigation.NavigateTo($"/devices/{evt.DeviceId}");
        }
    }

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
        SignalR.OnSyncEvent -= OnSyncEvent;
        _liveTimer?.Dispose();
    }
}
